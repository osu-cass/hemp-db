# Copy to .env on the staging host (Chef templates this file there).

# Image defaults to ghcr.io/osu-cass/hemp-db:dev (published from dev).
# Uncomment to pin a specific tag.
# HEMPDB_IMAGE=ghcr.io/osu-cass/hemp-db:dev

# Hostname only: do not include https://.
PRODUCTION_URL=hempdb-staging.cass.oregonstate.edu

# Docker secret source files. Keep these outside committed source.
SECRET_KEY_PATH=./docker/secrets/secret_key
DATABASE_URL_PATH=./docker/secrets/database_url

# Optional: leave empty to keep Sentry disabled.
SENTRY_DSN=

# Staging sends mail to the bundled Mailpit service. Do not add production
# SMTP settings here. The Mailpit UI is published through the load balancer,
# so protect it with basic auth in "user:password" form. This value is required;
# staging fails to start if it is empty. Generate a password with
# `openssl rand -base64 24`.
MAILPIT_UI_AUTH=
