# Copy to .env on the production host (Chef templates this file there).

# Image defaults to ghcr.io/osu-cass/hemp-db:latest (published from main).
# Uncomment to pin a specific tag, e.g. for a rollback.
# HEMPDB_IMAGE=ghcr.io/osu-cass/hemp-db:main

# Hostname only: do not include https://.
PRODUCTION_URL=hempdb.cass.oregonstate.edu

# Docker secret source files. Keep these outside committed source.
SECRET_KEY_PATH=./docker/secrets/secret_key
DATABASE_URL_PATH=./docker/secrets/database_url

# The OSL SMTP relay requires no authentication from allowed hosts.
EMAIL_HOST=smtp.osuosl.org
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=noreply@hempdb.cass.oregonstate.edu

# Optional: leave empty to keep Sentry disabled.
SENTRY_DSN=

# Compose supplies secure HTTPS/proxy defaults. Uncomment only for an
# intentional host-ingress override.
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# TRUST_X_FORWARDED_PROTO=true
# SECURE_HSTS_SECONDS=300
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# SECURE_HSTS_PRELOAD=false
