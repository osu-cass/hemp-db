SECRET_KEY=key-here
DEBUG=false

PRODUCTION_URL=hemp-db.cass.oregonstate.edu
ALLOWED_HOSTS=hemp-db.cass.oregonstate.edu
CSRF_TRUSTED_ORIGINS=https://hemp-db.cass.oregonstate.edu
EMAIL_LINK=https://hemp-db.cass.oregonstate.edu

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
TRUST_X_FORWARDED_PROTO=true
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

DATABASE_URL=mysql://<MYSQL_USER>:<MYSQL_PASS>@<MYSQL_HOST>/<MYSQL_NAME>
DATABASE_SSL=true
MYSQL_ATTR_SSL_CA=ca-certificate-path-here
DATABASE_CONN_MAX_AGE=600
DATABASE_CONN_HEALTH_CHECKS=true

REDIS_URL=redis://<user>:<password>@<valkey-host>:<port>/0

SENTRY_DSN=dsn-here
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
CSP_REPORT_URI=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.osuosl.org
EMAIL_PORT=25
EMAIL_USE_TLS=true
# The OSL relay needs no authentication; leave user and password empty.
EMAIL_USER=
EMAIL_APP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@hemp-db.cass.oregonstate.edu
AUDIT_RECIPIENT=personal-email-here
