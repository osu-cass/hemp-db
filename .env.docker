# Safe local-development values. Do not reuse these credentials outside Docker.
DEBUG=true
SECRET_KEY=NOT_A_SECRET_DEV_ONLY
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

MYSQL_DATABASE=hempdb
MYSQL_USER=hempdb
MYSQL_PASSWORD=hempdb
MYSQL_ROOT_PASSWORD=root
DATABASE_URL=mysql://hempdb:hempdb@mysql:3306/hempdb
DATABASE_SSL=false

REDIS_URL=redis://redis:6379/0

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=false
EMAIL_USER=developer@hempdb.local
EMAIL_APP_PASSWORD=
DEFAULT_FROM_EMAIL=developer@hempdb.local
EMAIL_LINK=http://localhost:8000
AUDIT_RECIPIENT=developer@hempdb.local

# Sentry is intentionally disabled for local development.
SENTRY_DSN=
